APP_ENV=development
APP_NAME=SELF-AGENT API
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_THINKING_ENABLED=false
LLM_MAX_OUTPUT_TOKENS=1024
REQUIRE_APPROVED_PERSONA=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
RATE_LIMIT_SESSION_PER_DAY=50
LOG_RAW_CONVERSATIONS=false
# Local llama.cpp: LLM_PROVIDER=local, LLM_BASE_URL=http://127.0.0.1:8010/v1,
# LLM_MODEL=local-model. Start your own model server; no weights are included.
# DeepSeek: LLM_PROVIDER=deepseek, DEEPSEEK_API_KEY=your-own-key,
# DEEPSEEK_MODEL=your-enabled-model; remove generic LLM_* overrides first.
# Custom persona: PERSONA_DIR=/absolute/path/to/your/private/persona
