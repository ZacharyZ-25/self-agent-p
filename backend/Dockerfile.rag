# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:0.10.7 AS uv

FROM python:3.12-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/
COPY backend/pyproject.toml backend/uv.lock ./
COPY backend/app ./app
RUN uv sync --frozen --no-dev --no-editable --extra knowledge
RUN /app/.venv/bin/python -c "from pathlib import Path; from app.knowledge.embeddings import LocalMultilingualEmbeddings; LocalMultilingualEmbeddings(Path('/app/model-cache'))"

FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KB_MODEL_CACHE_DIR=/app/model-cache \
    PATH="/app/.venv/bin:$PATH" \
    PORT=10000

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --from=builder --chown=app:app /app/model-cache /app/model-cache
COPY --chown=app:app persona.example /app/persona.example

USER app:app

EXPOSE 10000
STOPSIGNAL SIGTERM
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT}\""]
